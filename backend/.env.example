# Copy to .env for local development. Never commit real credentials.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=your-mongodb-connection-string

# Elevoni Assistant — OpenAI handles conversation intelligence and speech transcription.
# Create an API key in the OpenAI API platform and keep it server-side only.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TIMEOUT_MS=45000
OPENAI_TRANSCRIPTION_TIMEOUT_MS=90000

# ElevenLabs remains the speech-generation provider. Configure a dedicated voice ID
# for every language you intend to offer. Never expose these values in VITE_ variables.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_TTS_MODEL=eleven_v3
ELEVENLABS_ENGLISH_VOICE_ID=
ELEVENLABS_PIDGIN_VOICE_ID=
ELEVENLABS_HAUSA_VOICE_ID=
ELEVENLABS_IGBO_VOICE_ID=
ELEVENLABS_YORUBA_VOICE_ID=

# Local development: 0 means unlimited prompts. This is safe for localhost only.
# In the production backend deployment, set ASSISTANT_DAILY_LIMIT=10 explicitly.
ASSISTANT_DAILY_LIMIT=0
# Used only when the daily cap is enabled. Set a random secret of at least 32 characters
# in production. The legacy NATLAS secret is accepted as a temporary fallback.
ASSISTANT_USAGE_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
ASSISTANT_DAILY_LIMIT_TIME_ZONE=Africa/Lagos

# Assistant speech recognition provider. Use dynamic-asr after deploying the Modal 1B service.
ASSISTANT_ASR_PROVIDER=openai
DYNAMIC_ASR_MODAL_URL=
DYNAMIC_ASR_MODAL_API_KEY=
DYNAMIC_ASR_TIMEOUT_MS=150000

# Payment and media providers — server-side secrets only.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google identity and approved browser origins.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
FRONTEND_URL=https://elevonifarms.vercel.app
ADMIN_URL=https://elevoni-admin.vercel.app
VENDOR_PORTAL_URL=https://elevoni-vendors.vercel.app
