# Copy to .env for local development. Never commit real credentials.
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
MONGO_URI=your-mongodb-connection-string
# Public N-ATLaS access is enabled; the MongoDB rolling-30-day gate blocks new user 1,001 and above; existing active users can continue.
NATLAS_ENABLED=true
# Generate a dedicated random secret (at least 32 characters) for HMAC-hashing user identifiers.
NATLAS_USAGE_HMAC_SECRET=replace-with-a-random-secret-at-least-32-characters
# Gateway origin only; do not append /v1.
NATLAS_BASE_URL=https://your-authorized-modal-gateway-url
NATLAS_API_KEY=obtain-an-authorized-key-from-the-gateway-operator
NATLAS_MODEL=NCAIR1/N-ATLaS

# Existing English and Nigerian Pidgin speech provider. Hausa, Igbo and Yoruba use N-ATLaS. Keep keys server-side.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_v3
# Obtain the English and Pidgin voice IDs from your ElevenLabs account.
ELEVENLABS_ENGLISH_VOICE_ID=
ELEVENLABS_PIDGIN_VOICE_ID=
