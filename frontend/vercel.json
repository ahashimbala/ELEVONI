{
    "rewrites": [{
            "source": "/sitemap.xml",
            "destination": "https://elevoni-backend.vercel.app/sitemap.xml"
        },
        {
            "source": "/api/auth/google",
            "destination": "https://elevoni-backend.vercel.app/api/user/google"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [{
            "source": "/sw.js",
            "headers": [{
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                },
                {
                    "key": "Service-Worker-Allowed",
                    "value": "/"
                }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=0, must-revalidate"
            }]
        },
        {
            "source": "/assets/(.*)",
            "headers": [{
                "key": "Cache-Control",
                "value": "public, max-age=31536000, immutable"
            }]
        }
    ]
}
