# Enable the public Elevoni Assistant route in the production frontend build.
VITE_ELEVONI_ASSISTANT_ENABLED=true
# Legacy aliases are still accepted for existing deployments: VITE_TINKA_ENABLED and VITE_KONEKTA_ENABLED.
# Optional only: permit browser/device voice fallback when a cloud voice is unavailable. Defaults to false.
VITE_ALLOW_DEVICE_TTS_FALLBACK=false
# Local backend example:
# VITE_API_BASE_URL=http://localhost:5000
